CREATE TABLE LibrarySeriesRunResult (
    libraryId        TEXT NOT NULL,
    seriesId         TEXT NOT NULL,
    desiredHash      TEXT NOT NULL,
    status           TEXT NOT NULL,
    updatedAtEpochMs INTEGER NOT NULL,
    PRIMARY KEY (libraryId, seriesId)
);
CREATE INDEX library_series_result_library_idx ON LibrarySeriesRunResult(libraryId);
CREATE INDEX library_series_result_status_idx ON LibrarySeriesRunResult(status);

getForSeries:
SELECT * FROM LibrarySeriesRunResult WHERE libraryId = ? AND seriesId = ?;

upsert:
INSERT OR REPLACE INTO LibrarySeriesRunResult(
    libraryId,
    seriesId,
    desiredHash,
    status,
    updatedAtEpochMs
) VALUES (?, ?, ?, ?, ?);

deleteForLibrary:
DELETE FROM LibrarySeriesRunResult WHERE libraryId = ?;

